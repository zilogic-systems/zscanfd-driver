FROM rust:slim-trixie

ENV DEBIAN_FRONTEND=noninteractive

ENV CXX_COMPILER_NAME="g++"
ENV C_COMPILER_NAME="gcc"

ENV HOME=/root

RUN apt update \
    && apt install -y --no-install-recommends \
        wget \
        curl \
        ca-certificates \
        debian-archive-keyring \
        build-essential \
        git \
        zlib1g-dev \
        libssl-dev \
        libbz2-dev \
        libffi-dev \
        libreadline-dev \
        libncursesw5-dev \
        libsqlite3-dev \
        liblzma-dev \
    && rm -rf /var/lib/apt/lists/*

RUN wget --quiet --output-document=- https://pyenv.run | bash

ENV PYTHON_CONFIGURE_OPTS="--without-tkinter"

ENV PYENV_ROOT="${HOME}/.pyenv"
ENV PATH="${PYENV_ROOT}/shims:${PYENV_ROOT}/bin:$PATH"

ARG PYTHON_VERSIONS="3.10 3.11 3.12 3.13 3.14"

RUN for v in ${PYTHON_VERSIONS}; do (pyenv install -s "${v}"); done
